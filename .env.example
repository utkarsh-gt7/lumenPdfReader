# =============================================================================
# Local development environment — copy to .env.local and fill in your values.
# =============================================================================
# Vite load order: .env.local > .env.[mode].local > .env > .env.[mode]
#
# All values prefixed with VITE_ are bundled into the client. Firebase Web
# config keys are *public by design* — security is enforced by Firebase
# Auth + Firestore/Storage Rules, not by hiding the keys.
# =============================================================================

# Firebase Web Config — required (cloud-only mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the dictionary API base URL for local mocking
# Defaults to https://api.dictionaryapi.dev/api/v2/entries/en
VITE_DICTIONARY_API_URL=
